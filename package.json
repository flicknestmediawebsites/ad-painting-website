{
  "name": "ad-painting-special-fx",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "build": "vite build && node scripts/build-pages.mjs",
    "preview": "vite preview --port 4173",
    "photos": "python3 scripts/process-photos.py",
    "images": "node scripts/optimize-images.mjs",
    "check": "node scripts/check-html.mjs",
